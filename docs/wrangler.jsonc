{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The docs site: static files only, served by Cloudflare's asset handling. No Worker code.
	"name": "pgbackup-r2-docs",
	"compatibility_date": "2026-11-18",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
	},
	// Only pgbackup-r2.iotabyt.com serves the site. workers.dev and per-version preview URLs
	// would be public copies of every page that search engines could index, so both are off.
	// (Every page also has a canonical link to pgbackup-r2.iotabyt.com.) To preview a change,
	// build it and run `npm run preview`.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"logs": { "enabled": true },
	},
}
