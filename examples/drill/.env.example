# Copy this file to .env and fill it in. NEVER commit .env: it holds your private key.
# No quotes around values.

# Your R2 endpoint: Cloudflare dashboard > R2 > Overview > "S3 API" / account details
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The bucket, and the app's prefix inside it (the same S3_PREFIX the server uses)
S3_BUCKET=my-backups
S3_PREFIX=labpadi

# An R2 API token's keys. Read access is enough for drills.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The PRIVATE key from `keygen` (the AGE-SECRET-KEY-1... line). Keep it secret.
AGE_IDENTITY=
