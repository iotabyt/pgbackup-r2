# Copy this file to .env and fill it in. NEVER commit .env: it holds your private key.
# No quotes around values.

# Postgres major version: must match your server's major version (run SHOW server_version;)
# It picks both images: postgres:16 for the scratch database and pgbackup-r2:pg16.
PG_MAJOR=16

# Your R2 endpoint: Cloudflare dashboard > R2 > Overview > "S3 API" / account details
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The bucket, and the app's prefix inside it (the same S3_PREFIX the server uses)
S3_BUCKET=my-backups
S3_PREFIX=labpadi

# An R2 API token's keys. Read access is enough for drills; backups need Read & Write.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The PRIVATE key from `keygen` (the AGE-SECRET-KEY-1... line). Keep it secret.
# Needed for drill, verify, decrypt and restore.
AGE_IDENTITY=

# Optional: only to run `backup` from this folder.
# DATABASE_URL must be a direct (non-pooled) connection: pg_dump doesn't work through a
# transaction-mode pooler. For Neon, use the host without "-pooler".
DATABASE_URL=
# The PUBLIC key from `keygen` (age1...). Backups are encrypted to it.
AGE_RECIPIENTS=
